[
 {
  "from": "--font-ui",
  "to": "--font-family-sans",
  "note": "Instrument Sans → Atkinson Hyperlegible Next. Body goes 13.5 → 15px (--type-body-m)."
 },
 {
  "from": "--font-title",
  "to": "--font-family-serif",
  "note": "Instrument Serif italic → Fraunces SemiBold, upright. Use the --type-h1 / --type-h2 shorthands plus their -tracking and -variation. Long or generated titles move to --type-h3 (sans)."
 },
 {
  "from": "--font-mono",
  "to": "--font-family-mono",
  "note": "Martian Mono → Atkinson Hyperlegible Mono, and only for literal code, ids, YAML and logs. Strip cells, crumbs, counts, times and costs move to the sans with tabular-nums."
 },
 {
  "from": "--r-xs",
  "to": "--radius-badge",
  "note": "3 → 3: tags only. Nothing is a pill."
 },
 {
  "from": "--r-sm",
  "to": "--radius-control",
  "note": "5 → 10."
 },
 {
  "from": "--r",
  "to": "--radius-card",
  "note": "8 → 14."
 },
 {
  "from": "--r-lg",
  "to": "--radius-overlay",
  "note": "12 → 18."
 },
 {
  "from": "--rail-w",
  "to": "--size-rail",
  "note": "224 → 236 (212 compact)."
 },
 {
  "from": "--strip-h",
  "to": "--size-strip",
  "note": "34 → 60 (48 compact): the mono status strip becomes a quiet top bar (search, health, avatar)."
 },
 {
  "from": "--ease",
  "to": "--motion-easing-out",
  "note": ""
 },
 {
  "from": "--t-fast",
  "to": "--motion-duration-fast",
  "note": "Drops to 0 under reduced motion."
 },
 {
  "from": "--t",
  "to": "--motion-duration-base",
  "note": "220 → 200ms."
 },
 {
  "from": "--bg",
  "to": "--color-bg-canvas",
  "note": "Dark #0f100d → cocoa #1d1915; light #efeadf → cream #f7f3ec. Daylight is light-first."
 },
 {
  "from": "--bg-1",
  "to": "--color-bg-rail",
  "note": "Dark #13140f → #211c18; light #f4f0e6 → #f1ebe1."
 },
 {
  "from": "--bg-2",
  "to": "--color-bg-surface",
  "note": "Dark #181914 → #26211c; light #f9f6ef → #fffdf9."
 },
 {
  "from": "--bg-3",
  "to": "--color-bg-raised",
  "note": "Dark #1f201a → #2e2822; light #fffdf8 → #ffffff."
 },
 {
  "from": "--bg-4",
  "to": "--color-bg-overlay",
  "note": "Dark #272821 → #36302a; light #ffffff."
 },
 {
  "from": "--line",
  "to": "--color-border-subtle",
  "note": "Dark #2a2b23 → #352e27; light #ddd6c5 → #ece5d8."
 },
 {
  "from": "--line-2",
  "to": "--color-border-default",
  "note": "Inputs and checkboxes use --color-border-control (3:1) instead."
 },
 {
  "from": "--line-3",
  "to": "--color-border-strong",
  "note": ""
 },
 {
  "from": "--ink",
  "to": "--color-text-primary",
  "note": "Dark #ece8dc → #f4eee4; light #1b1a15 → #2a231c."
 },
 {
  "from": "--ink-2",
  "to": "--color-text-secondary",
  "note": "Dark #b6b1a2 → #ddd3c2; light #514d43 → #584e43."
 },
 {
  "from": "--ink-3",
  "to": "--color-text-tertiary",
