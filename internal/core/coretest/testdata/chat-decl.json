          "label": "message",
          "assigned": true,
          "scope": [
            {
              "dimension": "channel",
              "fact": "slack.channel"
            },
            {
              "dimension": "user",
              "fact": "slack.user"
            }
          ]
        },
        "author": {
          "login": "slack.user",
          "automated": "slack.is_bot"
        },
        "secret": [
          "slack_bot_token"
        ],
        "conversation_reply": {
          "id": "{{.slack.channel}}:{{.slack.thread_ts}}",
          "author": "slack.user",
          "text": "slack.text"
