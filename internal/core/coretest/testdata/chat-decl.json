        ]
      }
    },
    {
      "name": "reply",
      "desc": "a thread reply or a DM, as Socket Mode delivers them — consumed by a pending ask/hand-off when one is waiting on it, otherwise an ordinary event a trigger may match with `on: slack.reply`",
      "context": {
        "slack.callback_id": {
          "type": "string",
          "desc": "message_shortcut: the shortcut's callback id"
        },
        "slack.channel": {
          "type": "string"
        },
        "slack.command": {
          "type": "string"
        },
        "slack.files": {
          "type": "list",
          "desc": "files on the triggering message: {id, name, mimetype}"
        },
        "slack.form": {
          "type": "map",
          "desc": "submitted form values by field name"
        },
        "slack.is_bot": {
          "type": "boolean",
          "desc": "the acting user is a bot (bot_id was set)"
        },
        "slack.reaction": {
          "type": "string"
        },
        "slack.text": {
          "type": "string"
        },
        "slack.thread_ts": {
          "type": "string"
        },
        "slack.trigger_id": {
          "type": "string",
          "desc": "slash_command: the invocation's unique trigger id (Slack mints no message ts for a command, so this is its target discriminator instead)"
